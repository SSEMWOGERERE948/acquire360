# Copy this file to .env in this directory and fill in real values for local development.
# On Replit, set these as Secrets instead of committing a .env file.

# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/acquire360

# Any long random string - used to sign admin session cookies.
JWT_SECRET=replace-with-a-long-random-string

# Cloudflare R2 (S3-compatible) storage - used for image/document uploads.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=acquire360

# Public base URL for the bucket - either its R2.dev public development URL
# or a custom domain connected to the bucket in Cloudflare.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Optional - used by `pnpm run seed` to create the first admin login.
SEED_ADMIN_EMAIL=admin@acquire360ventures.com
SEED_ADMIN_PASSWORD=ChangeMe123!
